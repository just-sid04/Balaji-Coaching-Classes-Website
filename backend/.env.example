# ========================================
# SHREE BALAJI COACHING CLASSES — Backend
# ========================================

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=30d

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (for password reset — use Gmail SMTP or similar)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@balajicoachingnandurbar.com

# Frontend URL (for CORS & email links)
FRONTEND_URL=http://localhost:5173

# Admin seed credentials (used only on first `npm run seed`)
SEED_ADMIN_EMAIL=admin@balaji.edu
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_NAME=Prof. Ravindra Thakare
